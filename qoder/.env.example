# Copy to .env and adjust for your machine. Never commit real credentials.

# Runtime data (uploads, page cache, logs). Relative paths resolve from the
# process working directory; run scripts/run.sh from the project root.
CITEFLOW_RUNTIME_DIR=runtime

# seekdb (MySQL protocol). Start it with scripts/start_seekdb.sh.
CITEFLOW_SEEKDB_HOST=127.0.0.1
CITEFLOW_SEEKDB_PORT=2891
CITEFLOW_SEEKDB_USER=root
CITEFLOW_SEEKDB_PASSWORD=
CITEFLOW_SEEKDB_DATABASE=citeflow

# Embeddings: auto tries fastembed, then falls back to a deterministic hashing
# embedder. Set to hash for an offline/no-download run.
CITEFLOW_EMBEDDING_BACKEND=auto
CITEFLOW_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CITEFLOW_EMBEDDING_DIM=384
CITEFLOW_EMBEDDING_BATCH_SIZE=32
# Optional mirror, e.g. https://hf-mirror.com
CITEFLOW_HF_ENDPOINT=

# Optional PowerContext memory. auto = use if reachable, otherwise fall back to
# the seekdb mirror. Set off to disable entirely.
CITEFLOW_POWERCONTEXT=auto
CITEFLOW_POWERCONTEXT_URL=http://127.0.0.1:17429
CITEFLOW_POWERCONTEXT_TIMEOUT=2.0

# Optional OpenAI-compatible LLM. All three values are required to enable it;
# the app stays fully usable without them (extractive answers).
CITEFLOW_LLM_BASE_URL=
CITEFLOW_LLM_API_KEY=
CITEFLOW_LLM_MODEL=
CITEFLOW_LLM_TIMEOUT=60

# Web server
CITEFLOW_HOST=127.0.0.1
CITEFLOW_PORT=8848

# Upload and retrieval limits
CITEFLOW_MAX_UPLOAD_MB=30
